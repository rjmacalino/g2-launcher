{
  "name": "g2-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist -o g2-launcher.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173",
    "qr": "node scripts/qr.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,html}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,html}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test && npx vite build"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.15",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
